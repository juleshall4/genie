<?xml version="1.0" encoding="utf-8"?>
<!-- Puff talks you through setup: Puff in the middle, its line in a bubble below, and a button when there's
     something to do. Sizes match the Meet Puff prototype, where 1 unit is 1dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/onboarding_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/onboarding_dots"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal" />
            <TextView
                android:id="@+id/onboarding_skip"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:paddingStart="12dp"
                android:text="@string/onboarding_skip"
                android:textColor="@color/genie_muted"
                android:textFontWeight="500"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/onboarding_stage"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false">
            <ImageView
                android:id="@+id/onboarding_puff"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:rotation="-6" />
            <LinearLayout
                android:id="@+id/onboarding_pill"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="24dp"
                android:rotation="-2"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/onboarding_pill_puff"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:importantForAccessibility="no" />
                <TextView
                    android:id="@+id/onboarding_pill_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:fontFamily="@font/inter"
                    android:lineHeight="23sp"
                    android:minWidth="150dp"
                    android:textColor="@color/genie_text"
                    android:textFontWeight="500"
                    android:textSize="17sp" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/onboarding_bubble"
            android:paddingStart="22dp"
            android:paddingTop="22dp"
            android:paddingEnd="22dp"
            android:paddingBottom="30dp">
            <TextView
                android:id="@+id/onboarding_line"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:fontFamily="@font/inter"
                android:letterSpacing="-0.01"
                android:lineHeight="29sp"
                android:minHeight="58dp"
                android:textColor="@color/genie_text"
                android:textFontWeight="500"
                android:textSize="22sp" />
            <ImageView
                android:id="@+id/onboarding_next"
                android:layout_width="16dp"
                android:layout_height="12dp"
                android:layout_gravity="end|bottom"
                android:layout_marginEnd="-2dp"
                android:layout_marginBottom="-16dp"
                android:alpha="0"
                android:importantForAccessibility="no"
                android:src="@drawable/onboarding_next" />
        </FrameLayout>

        <!-- The buttons' slot is always there, so the bubble and Puff never move when they appear. -->
        <LinearLayout
            android:id="@+id/onboarding_actions"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:forceHasOverlappingRendering="false"
            android:gravity="center_horizontal|bottom"
            android:orientation="horizontal"
            android:visibility="invisible">
            <TextView
                android:id="@+id/onboarding_primary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:background="@drawable/onboarding_button"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:textColor="@android:color/black"
                android:textFontWeight="600"
                android:textSize="17sp" />
            <TextView
                android:id="@+id/onboarding_secondary"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:fontFamily="@font/inter"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:textColor="@color/genie_muted"
                android:textFontWeight="500"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
