<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/genie_scrim"
        android:contentDescription="@string/close_overlay" />
    <LinearLayout
        android:id="@+id/genie_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/genie_box"
        android:clickable="true"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/orb_frame"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="noHideDescendants">
                <WebView
                    android:id="@+id/orb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>
            <LinearLayout
                android:id="@+id/genie_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/speech_transcript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/genie_text"
                    android:textSize="17sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/speech_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:text="@string/speech_starting"
                    android:textColor="@color/genie_muted"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
        <dev.genie.android.PopupScrollView
            android:id="@+id/answer_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/chatgpt_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:fontFamily="sans-serif"
                    android:letterSpacing="-0.01"
                    android:lineHeight="29sp"
                    android:textColor="@color/genie_text"
                    android:textSize="22sp" />
                <Button
                    android:id="@+id/answer_sources"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="@string/answer_sources"
                    android:textAllCaps="false"
                    android:textColor="@color/genie_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/source_links"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/genie_muted"
                    android:textColorLink="@color/genie_text"
                    android:textSize="14sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/read_aloud_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/genie_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/chatgpt_plan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chatgpt_using_plan"
                    android:textColor="@color/genie_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </dev.genie.android.PopupScrollView>
        <Button
            android:id="@+id/speech_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/genie_action"
            android:stateListAnimator="@null"
            android:text="@string/speech_retry"
            android:textAllCaps="false"
            android:textColor="@color/genie_text"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
