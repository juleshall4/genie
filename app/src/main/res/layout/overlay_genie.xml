<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/overlay_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/genie_scrim"
        android:contentDescription="@string/close_overlay" />
    <LinearLayout
        android:id="@+id/genie_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/genie_box"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="22dp"
        android:paddingBottom="10dp">
        <View
            android:id="@+id/swipe_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/genie_handle"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/genie_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <FrameLayout
                android:id="@+id/orb_frame"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="12dp"
                android:importantForAccessibility="noHideDescendants">
                <WebView
                    android:id="@+id/orb"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:clickable="false"
                    android:focusable="false" />
            </FrameLayout>
            <LinearLayout
                android:id="@+id/genie_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/speech_transcript"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:textColor="@color/genie_text"
                    android:textSize="17sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/speech_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:text="@string/speech_starting"
                    android:textColor="@color/genie_muted"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>
        <dev.genie.android.PopupScrollView
            android:id="@+id/answer_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fadingEdgeLength="64dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:scrollbarThumbVertical="@drawable/genie_scroll_thumb"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbars="none"
            android:visibility="gone">
            <LinearLayout
                android:id="@+id/conversation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">
                <LinearLayout
                    android:id="@+id/history_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/current_question"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:lineHeight="20sp"
                    android:textColor="@color/genie_muted"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/chatgpt_answer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/inter"
                    android:letterSpacing="-0.01"
                    android:lineHeight="29sp"
                    android:textColor="@color/genie_text"
                    android:textSize="22sp" />
                <LinearLayout
                    android:id="@+id/link_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/genie_card"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">
                    <ImageView
                        android:id="@+id/link_thumbnail"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/genie_thumbnail"
                        android:importantForAccessibility="no"
                        android:scaleType="centerCrop" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <FrameLayout
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:background="@drawable/genie_favicon"
                                android:importantForAccessibility="noHideDescendants">
                                <TextView
                                    android:id="@+id/link_favicon_letter"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:fontFamily="serif"
                                    android:gravity="center"
                                    android:includeFontPadding="false"
                                    android:textColor="#000000"
                                    android:textSize="10sp" />
                                <ImageView
                                    android:id="@+id/link_favicon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:scaleType="fitCenter"
                                    android:visibility="gone" />
                            </FrameLayout>
                            <TextView
                                android:id="@+id/link_domain"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:fontFamily="@font/inter"
                                android:maxLines="1"
                                android:textColor="@color/genie_muted"
                                android:textSize="13sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/link_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:textColor="@color/genie_text"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/link_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/inter"
                            android:maxLines="1"
                            android:textColor="@color/genie_muted"
                            android:textSize="13sp"
                            android:visibility="gone" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="14dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_open_link" />
                </LinearLayout>
                <TextView
                    android:id="@+id/read_aloud_status"
                    android:fontFamily="@font/inter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/genie_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/chatgpt_plan"
                    android:fontFamily="@font/inter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:text="@string/chatgpt_using_plan"
                    android:textColor="@color/genie_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </dev.genie.android.PopupScrollView>
        <Button
            android:id="@+id/speech_action"
                    android:fontFamily="@font/inter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:minHeight="44dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/genie_action"
            android:stateListAnimator="@null"
            android:text="@string/speech_retry"
            android:textAllCaps="false"
            android:textColor="@color/genie_text"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
