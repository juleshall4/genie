<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/main_root" android:focusableInTouchMode="true" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/settings_title" android:textColor="@color/ink" android:textSize="32sp" android:fontFamily="@font/inter" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/settings_shortcut" android:textSize="20sp" android:textColor="@color/ink" android:fontFamily="@font/inter" android:textStyle="bold" />
        <TextView android:id="@+id/shortcut_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/shortcut_disabled" android:textColor="@color/ink" android:textSize="14sp" />
        <Button android:id="@+id/shortcut_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="56dp" android:backgroundTint="@color/ink" android:text="@string/enable_shortcut" android:textAllCaps="false" android:textColor="@android:color/white" />
        <Button android:id="@+id/microphone_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:minHeight="48dp" android:text="@string/enable_microphone" android:textAllCaps="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/settings_voice" android:textSize="20sp" android:textColor="@color/ink" android:fontFamily="@font/inter" android:textStyle="bold" />
        <Switch android:id="@+id/read_aloud_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/read_aloud_enabled" />
        <Button android:id="@+id/read_aloud_voice" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/read_aloud_voice" android:textAllCaps="false" />
        <Button android:id="@+id/read_aloud_speed" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/read_aloud_speed" android:textAllCaps="false" />
        <Button android:id="@+id/read_aloud_test" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/read_aloud_test" android:textAllCaps="false" />
        <TextView android:id="@+id/read_aloud_usage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:textColor="@color/ink" android:textSize="16sp" />
        <ProgressBar android:id="@+id/read_aloud_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/read_aloud_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/read_aloud_settings" android:textAllCaps="false" />
        <TextView android:id="@+id/read_aloud_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="14sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/settings_chatgpt" android:textSize="20sp" android:textColor="@color/ink" android:fontFamily="@font/inter" android:textStyle="bold" />
        <TextView android:id="@+id/chatgpt_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/chatgpt_connect_needed" android:textColor="@color/ink" android:textSize="16sp" />
        <Button android:id="@+id/chatgpt_settings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chatgpt_continue" android:textAllCaps="false" />
        <Button android:id="@+id/chatgpt_model" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chatgpt_choose_model" android:textAllCaps="false" android:enabled="false" />
        <Button android:id="@+id/chatgpt_reasoning" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chatgpt_choose_reasoning" android:textAllCaps="false" android:enabled="false" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/chatgpt_personality" android:labelFor="@id/chatgpt_personality" android:textSize="16sp" android:textColor="@color/ink" />
        <EditText android:id="@+id/chatgpt_personality" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textMultiLine|textCapSentences" android:gravity="top|start" android:minLines="4" android:maxLines="8" android:textSize="16sp" android:importantForAutofill="no" />
        <Button android:id="@+id/chatgpt_reset_personality" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chatgpt_reset_personality" android:textAllCaps="false" />
        <TextView android:id="@+id/chatgpt_configuration_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="@color/muted" android:textSize="14sp" android:visibility="gone" />
        <Button android:id="@+id/chatgpt_refresh_models" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chatgpt_refresh_models" android:textAllCaps="false" />
        <Button android:id="@+id/chatgpt_usage" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/chatgpt_manage_usage" android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>