<?xml version="1.0" encoding="utf-8"?>
<!-- On is a white thumb on a grey track; off is a grey thumb on a dark track. Both stand out on black. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <size android:width="51dp" android:height="31dp" />
            <solid android:color="@color/genie_muted" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <size android:width="51dp" android:height="31dp" />
            <solid android:color="@color/genie_control" />
        </shape>
    </item>
</selector>
